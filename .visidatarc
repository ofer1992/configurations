def set_sum(lists_column):
    'Aggregate list/tuple/set-valued cells into a list of unique items (union).'
    unique_items = set()
    for item in lists_column:
        # Check if the cell contains a valid iterable (list, tuple, set)
        if isinstance(item, (list, tuple, set)):
            unique_items.update(item)
    return list(unique_items)

vd.aggregator('set_sum', set_sum, type=list)

# open .duckdb/.ddb files via the vdsql (ibis) app bundled with visidata;
# needs ibis-framework[duckdb] in the vd env, which the uv tool install has.
import visidata.apps.vdsql  # noqa: F401 -- defines vd.open_vdsql
for _ext in ('duckdb', 'ddb'):
    setattr(vd, f'open_{_ext}', vd.open_vdsql)
